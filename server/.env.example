# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# Port the API listens on.
PORT=5000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/merosadak
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/merosadak
MONGODB_URI=mongodb://127.0.0.1:27017/merosadak

# Where the React dev server runs — used for CORS.
CLIENT_ORIGIN=http://localhost:5173
